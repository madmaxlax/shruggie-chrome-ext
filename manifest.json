{
  "manifest_version": 3,

  "name": "Shruggie",
  "short_name": "Shruggie",
  "description": "Copies the shruggie ¯\\_(ツ)_/¯ to your clipboard",
  "version": "1.0",
  "action": {
    "default_icon": {
      "16": "shruggie-16.png",
      "32": "shruggie-32.png",
      "48": "shruggie-48.png",
      "128": "shruggie-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "icons": {
    "16": "shruggie-16.png",
    "32": "shruggie-32.png",
    "48": "shruggie-48.png",
    "128": "shruggie-128.png"
  }
}
